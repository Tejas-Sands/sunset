  "sentences": [
    {
      "index": 1,
      "text": "The sponsors need a wallet. The learners don't.",
      "start": 0.6,
      "end": 3.45058,
      "duration": 2.85058,
      "audio_file": "sentence-01.wav"
    },
    {
      "index": 2,
      "text": "This is SUNSET.",
      "start": 3.79058,
      "end": 5.07058,
      "duration": 1.28,
      "audio_file": "sentence-02.wav"
    },
    {
      "index": 3,
      "text": "A way to fund learning resources once, and let everyone keep a copy.",
      "start": 5.41058,
      "end": 9.73325,
      "duration": 4.32267,
      "audio_file": "sentence-03.wav"
    },
    {
      "index": 4,
      "text": "Adults sponsor the public release of a finished learning pack.",
      "start": 10.07325,
      "end": 13.73187,
      "duration": 3.65862,
      "audio_file": "sentence-04.wav"
    },
    {
      "index": 5,
      "text": "The agreement fixes the creator, the funding cap, the reviewer, and the deadlines.",
      "start": 14.07187,
      "end": 18.92383,
      "duration": 4.85196,
      "audio_file": "sentence-05.wav"
    },
    {
      "index": 6,
      "text": "Contributions go into a contract on NEAR testnet.",
      "start": 19.26383,
      "end": 22.7545,
      "duration": 3.49067,
      "audio_file": "sentence-06.wav"
    },
    {
      "index": 7,
      "text": "Its funding and release rules are publicly inspectable.",
      "start": 23.0945,
      "end": 26.69183,
      "duration": 3.59733,
      "audio_file": "sentence-07.wav"
    },
    {
      "index": 8,
      "text": "A matching release key, published on time, credits the agreed creator.",
      "start": 27.03183,
      "end": 31.38583,
      "duration": 4.354,
      "audio_file": "sentence-08.wav"
    },
    {
      "index": 9,
      "text": "The creator then withdraws that credit.",
      "start": 31.72583,
      "end": 34.18246,
      "duration": 2.45662,
      "audio_file": "sentence-09.wav"
    },
    {
      "index": 10,
      "text": "Miss the funding or release deadline, and contributors can claim and withdraw refunds.",
      "start": 34.52246,
      "end": 40.13242,
      "duration": 5.60996,
      "audio_file": "sentence-10.wav"
    },
    {
      "index": 11,
      "text": "After a successful release, download the game and keep it.",
      "start": 40.47242,
      "end": 44.02838,
      "duration": 3.55596,
      "audio_file": "sentence-11.wav"
    },
    {
      "index": 12,
      "text": "Close the website. Turn off the internet. Keep playing.",
      "start": 44.36838,
      "end": 47.85225,
      "duration": 3.48387,
      "audio_file": "sentence-12.wav"
    },
    {
      "index": 13,
      "text": "No learner account. No learner wallet.",
      "start": 48.19225,
      "end": 50.8895,
      "duration": 2.69725,
      "audio_file": "sentence-13.wav"
    },
    {
      "index": 14,
      "text": "And the token has a job.",
      "start": 51.2295,
      "end": 53.06746,
      "duration": 1.83796,
      "audio_file": "sentence-14.wav"
    },
    {
      "index": 15,
      "text": "Its current holder can maintain a verified discovery mirror.",
      "start": 53.40746,
      "end": 57.28213,
      "duration": 3.87467,
      "audio_file": "sentence-15.wav"
    },
    {
      "index": 16,
      "text": "Transfer it, and pass on maintenance responsibility.",
      "start": 57.62213,
      "end": 60.97613,
      "duration": 3.354,
      "audio_file": "sentence-16.wav"
    },
    {
      "index": 17,
      "text": "The content stays public. The creator's payment stays fixed.",
      "start": 61.31613,
      "end": 65.16808,
      "duration": 3.85196,
      "audio_file": "sentence-17.wav"
    },
    {
      "index": 18,
      "text": "SUNSET.",
      "start": 65.50808,
      "end": 66.53208,
      "duration": 1.024,
      "audio_file": "sentence-18.wav"
    },
    {
      "index": 19,
      "text": "Support once. Share forever.",
      "start": 66.87208,
      "end": 69.08604,
      "duration": 2.21396,
      "audio_file": "sentence-19.wav"
    },
    {
      "index": 20,
      "text": "Explore the prototype. Built on NEAR testnet.",
      "start": 69.42604,
      "end": 72.49004,
      "duration": 3.064,
      "audio_file": "sentence-20.wav"
    }
  ],
