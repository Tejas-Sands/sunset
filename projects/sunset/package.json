{
  "name": "sunset-public-goods",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
