{
  "name": "sunset-public-goods",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:contract": "node --test --test-isolation=none contracts/sunset/tests/wasm.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check": "npm test && npm run typecheck && npm run verify:local && npm run check:artifact && npm run test:contract",
    "test:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
