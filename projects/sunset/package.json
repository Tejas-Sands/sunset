    "test:contract": "node --test --test-isolation=none contracts/sunset/tests/wasm.test.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
